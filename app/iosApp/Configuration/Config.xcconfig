TEAM_ID=

PRODUCT_NAME=Jaiqal
PRODUCT_BUNDLE_IDENTIFIER=com.alad1nks.jaiqal.Jaiqal$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Xcode treats a literal // in an xcconfig value as a comment.
API_BASE_URL=https:/$()/api.example.invalid
API_BASE_URL[config=Debug]=http:/$()/127.0.0.1:8080
APP_ENVIRONMENT=production
APP_ENVIRONMENT[config=Debug]=local
PRIVACY_POLICY_URL=

// Optional, untracked override for a physical device; see Local.xcconfig.example.
#include? "Local.xcconfig"
