# Local development only. Do not reuse these values in production.
HTTP_PORT=8080
APP_ENVIRONMENT=development
# Production requires the full lowercase Git SHA used to build the deployed
# image. The liveness response exposes it for deployment/DAST correlation.
# DEPLOYMENT_COMMIT_SHA=0123456789abcdef0123456789abcdef01234567
# Production requires an HTTPS origin and a trusted ingress that overwrites
# X-Forwarded-Proto. The application port must not be publicly reachable.
# PUBLIC_API_URL=https://api.example.com
TRUSTED_PROXY_TERMINATES_TLS=false
# Production requires literal IPv4/IPv6 ingress networks. Use the smallest actual
# direct-peer ranges; hostnames, non-canonical networks and /0 are rejected.
# TRUSTED_PROXY_CIDRS=10.42.0.0/16,2001:db8:42::/64
DATABASE_URL=jdbc:postgresql://postgres:5432/jaiqal
# Runtime role: grant only CONNECT, schema USAGE, and required DML/sequence rights.
# It must not own application objects or have schema CREATE/DDL privileges.
DATABASE_USER=jaiqal
DATABASE_PASSWORD=jaiqal-local-password
# Production orchestrators may omit DATABASE_PASSWORD and mount a bounded,
# read-only UTF-8 secret instead.
# DATABASE_PASSWORD_FILE=/var/run/secrets/jaiqal/database-password
# Production migration jobs use a separate secret set. Never expose these three
# variables to the production server process. Development falls back to DATABASE_*.
# MIGRATION_DATABASE_URL=jdbc:postgresql://postgres:5432/jaiqal
# MIGRATION_DATABASE_USER=jaiqal_migrator
# MIGRATION_DATABASE_PASSWORD=replace-with-migration-secret
# MIGRATION_DATABASE_PASSWORD_FILE=/var/run/secrets/jaiqal-migration/database-password
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Firebase Admin uses Application Default Credentials. For local JVM runs, point
# this at a service-account JSON stored outside the repository. Do not commit it.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# For the optional compose.firebase.yaml override, set the host-side source path:
# FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json

# Operator-only device provisioning. The command refuses CI, requires the exact
# confirmation value, and creates (never overwrites) an absolute 0600 file.
# Do not set these variables on the runtime server or commit the output file.
# PROVISIONING_CONFIRM=I_UNDERSTAND_DEVICE_SECRETS
# DEVICE_CREDENTIALS_FILE=/absolute/private/path/new-device.credentials

# API DTO length/format limits are fixed security boundaries documented in README
# and are intentionally not configurable through the environment.
# Optional tuning (application defaults are shown).
FIREBASE_CHECK_REVOKED_TOKENS=false
FIREBASE_AUTO_PROVISION_USERS=true
HTTP_MAX_BODY_BYTES=65536
TELEMETRY_BATCH_MAX_BODY_BYTES=131072
RATE_LIMIT_PERIOD_SECONDS=60
READINESS_RATE_LIMIT_REQUESTS=30
READINESS_CACHE_TTL_MILLISECONDS=1000
USER_API_RATE_LIMIT_REQUESTS=120
TELEMETRY_RATE_LIMIT_REQUESTS=120
SSE_MAX_CONNECTIONS_PER_USER=3
SSE_MAX_CONNECTIONS_PER_IP=10
SSE_MAX_LIFETIME_SECONDS=300
SSE_OWNERSHIP_RECHECK_SECONDS=30
TELEMETRY_PAST_WINDOW_SECONDS=2592000
TELEMETRY_FUTURE_WINDOW_SECONDS=300
TELEMETRY_MIN_TEMPERATURE_CELSIUS=-50
TELEMETRY_MAX_TEMPERATURE_CELSIUS=100
TELEMETRY_MIN_ADC=0
TELEMETRY_MAX_ADC=65535
TELEMETRY_NEXT_UPLOAD_SECONDS=60
TELEMETRY_DEVICE_QUOTA_PERIOD_SECONDS=86400
TELEMETRY_DEVICE_QUOTA_MAX_MEASUREMENTS=1440
# One burst counts as one breached window. At least three distinct breached quota
# windows are required before a bounded, owner-recoverable quarantine.
TELEMETRY_ANOMALY_BREACH_WINDOWS=3
TELEMETRY_ANOMALY_WINDOW_SECONDS=604800
TELEMETRY_QUARANTINE_SECONDS=3600
TELEMETRY_RETENTION_DAYS=365
TELEMETRY_RETENTION_INTERVAL_SECONDS=3600
TELEMETRY_RETENTION_BATCH_SIZE=5000
TELEMETRY_RETENTION_MAX_BATCHES_PER_RUN=20
CAPACITY_MONITOR_INTERVAL_SECONDS=300
CAPACITY_MEASUREMENTS_WARN_ROWS=10000000
CAPACITY_MEASUREMENTS_WARN_BYTES=5368709120
CAPACITY_DATABASE_WARN_BYTES=10737418240
HISTORY_MAX_RANGE_SECONDS=31536000
HISTORY_DEFAULT_RANGE_SECONDS=86400
HISTORY_MAX_POINTS=2000
DEVICE_ONLINE_WINDOW_SECONDS=180
SSE_HEARTBEAT_SECONDS=15
ALERT_EVALUATION_SECONDS=30
NOTIFICATION_OUTBOX_POLL_SECONDS=5
NOTIFICATION_OUTBOX_BATCH_SIZE=25
NOTIFICATION_OUTBOX_MAX_BACKOFF_SECONDS=3600
